{
  "openrpc": "1.3.2",
  "info": {
    "title": "Ping-pong configuration commands",
    "version": "0.1.0",
    "description": "Single-call JSON-RPC 2.0 over the config-rpc web trigger. Requires Authorization: Bearer <per-environment runtime secret>. Batches, notifications, positional params, and null IDs are unsupported. The peer-event endpoint does not use this credential."
  },
  "methods": [
    {
      "name": "endpoint.get",
      "summary": "Get this installation's SDK-derived peer event URL",
      "params": [],
      "paramStructure": "by-name",
      "result": {
        "name": "result",
        "schema": {
          "type": "object",
          "required": ["eventUrl"],
          "additionalProperties": false,
          "properties": { "eventUrl": { "type": "string", "format": "uri" } }
        }
      },
      "errors": [
        { "code": -32600, "message": "Invalid Request" },
        { "code": -32601, "message": "Method not found" },
        { "code": -32602, "message": "Invalid params" },
        { "code": -32603, "message": "Internal error" },
        { "code": -32700, "message": "Parse error" },
        { "code": -32001, "message": "Unauthorized" }
      ]
    },
    {
      "name": "connections.list",
      "summary": "List this installation's configured peers without probing them",
      "params": [],
      "paramStructure": "by-name",
      "result": {
        "name": "result",
        "schema": {
          "type": "object",
          "required": ["connections"],
          "additionalProperties": false,
          "properties": {
            "connections": {
              "type": "array",
              "maxItems": 20,
              "items": { "$ref": "#/components/schemas/Connection" }
            }
          }
        }
      },
      "errors": [
        { "code": -32600, "message": "Invalid Request" },
        { "code": -32601, "message": "Method not found" },
        { "code": -32602, "message": "Invalid params" },
        { "code": -32603, "message": "Internal error" },
        { "code": -32700, "message": "Parse error" },
        { "code": -32002, "message": "Configuration unavailable" },
        { "code": -32001, "message": "Unauthorized" }
      ]
    },
    {
      "name": "connections.create",
      "summary": "Save an immutable peer connection without contacting the peer",
      "params": [
        {
          "name": "name",
          "required": true,
          "schema": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        {
          "name": "eventUrl",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uri",
            "description": "HTTPS URL, at most 2048 UTF-8 bytes; no credentials, query, fragment, or self-connection."
          }
        }
      ],
      "paramStructure": "by-name",
      "result": {
        "name": "result",
        "schema": {
          "type": "object",
          "required": ["connection"],
          "additionalProperties": false,
          "properties": {
            "connection": { "$ref": "#/components/schemas/Connection" }
          }
        }
      },
      "errors": [
        { "code": -32600, "message": "Invalid Request" },
        { "code": -32601, "message": "Method not found" },
        { "code": -32602, "message": "Invalid params" },
        { "code": -32603, "message": "Internal error" },
        { "code": -32700, "message": "Parse error" },
        { "code": -32002, "message": "Configuration unavailable" },
        { "code": -32001, "message": "Unauthorized" }
      ]
    },
    {
      "name": "connections.delete",
      "summary": "Delete a peer connection by stable ID, idempotently",
      "params": [
        {
          "name": "connectionId",
          "required": true,
          "schema": { "type": "string", "minLength": 1 }
        }
      ],
      "paramStructure": "by-name",
      "result": {
        "name": "result",
        "schema": {
          "type": "object",
          "required": ["deleted"],
          "additionalProperties": false,
          "properties": { "deleted": { "type": "boolean" } }
        }
      },
      "errors": [
        { "code": -32600, "message": "Invalid Request" },
        { "code": -32601, "message": "Method not found" },
        { "code": -32602, "message": "Invalid params" },
        { "code": -32603, "message": "Internal error" },
        { "code": -32700, "message": "Parse error" },
        { "code": -32002, "message": "Configuration unavailable" },
        { "code": -32001, "message": "Unauthorized" }
      ]
    },
    {
      "name": "ping.send",
      "summary": "Send one ping to a configured peer; success acknowledges delivery, not pong receipt",
      "params": [
        {
          "name": "connectionId",
          "required": true,
          "schema": { "type": "string", "minLength": 1 }
        }
      ],
      "paramStructure": "by-name",
      "result": {
        "name": "result",
        "schema": {
          "type": "object",
          "required": ["delivered", "pingId", "traceId"],
          "additionalProperties": false,
          "properties": {
            "delivered": { "type": "boolean", "const": true },
            "pingId": { "type": "string", "format": "uuid" },
            "traceId": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
          }
        }
      },
      "errors": [
        { "code": -32600, "message": "Invalid Request" },
        { "code": -32601, "message": "Method not found" },
        { "code": -32602, "message": "Invalid params" },
        { "code": -32603, "message": "Internal error" },
        { "code": -32700, "message": "Parse error" },
        { "code": -32002, "message": "Configuration unavailable" },
        { "code": -32003, "message": "Ping delivery failed" },
        { "code": -32001, "message": "Unauthorized" }
      ]
    }
  ],
  "components": {
    "schemas": {
      "Connection": {
        "type": "object",
        "required": ["id", "name", "eventUrl"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "eventUrl": {
            "type": "string",
            "format": "uri",
            "description": "Exact configured HTTPS capability URL, at most 2048 UTF-8 bytes."
          }
        }
      }
    }
  }
}
